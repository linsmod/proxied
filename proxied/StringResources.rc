#include <windows.h>
#include "StringResources.h"

// 中性语言（英文兜底）字符串表。
// 语言资源直接参与编译，不要再通过 .rc include 拆分：
// MSBuild 的 RC 任务不会把被 include 的 .rc 记为编译依赖，
// 改了子文件却未触发重编译时会继续用旧字符串。

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

STRINGTABLE
BEGIN
    IDS_ENABLE_PROXY          "Enable Proxy"
    IDS_DISABLE_PROXY         "Disable Proxy"
    IDS_AUTOSTART             "Start with Windows"
    IDS_GIT_PROXY_SYNC        "Make Git follow proxy changes"
    IDS_WSL_GIT_PROXY_SYNC    "Make Git (WSL) follow proxy changes"
    IDS_GRADLE_PROXY_SYNC     "Make Gradle follow proxy changes"
    IDS_ABOUT                 "About Proxied"
    IDS_EXIT                  "Exit"
    IDS_LOADING               "Proxied - Loading..."
    IDS_PROCESSING            "Proxied - Processing..."
    IDS_PROXY_ENABLED         "Proxied - Proxy Enabled"
    IDS_PROXY_DISABLED        "Proxied - Proxy Disabled"
    IDS_CANNOT_START_TASK     "Cannot start background task."
    IDS_WSL_GIT_ERROR         "Cannot modify WSL Git proxy settings. Please check if WSL and Git are installed."
    IDS_APP_TITLE             "Proxied"
    IDS_PROXY_SETTINGS        "Proxy settings"
    IDS_HTTP_PROXY            "HTTP proxy address:"
    IDS_SOCKS5_PROXY          "SOCKS5 proxy:"
    IDS_CURRENT_VERSION       "Current version: "
    IDS_SAVE                  "Save"
    IDS_CANCEL                "Cancel"
    IDS_INVALID_PROXY         "Enter a valid proxy address with a host and port (1-65535), and configure at least one proxy."
    IDS_PROXY_SAVE_ERROR      "Cannot save proxy settings to the Windows registry."
    IDS_PROXY_HINT            "Note: SOCKS5 works with Git, Gradle, and environment variables. The Windows system proxy only supports SOCKS4 (no auth, no IPv6), so SOCKS5-only proxies cannot be used as the system proxy; use a proxy that supports both SOCKS4 and SOCKS5 instead."

END
